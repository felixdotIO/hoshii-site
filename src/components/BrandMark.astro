---
/**
 * The Hoshii mark. Inline SVG rather than a file, because it is painted in two
 * colour arrangements (green on bone in the header, bone on green in the
 * footer) from CSS custom properties, and because two rectangles and a bar are
 * cheaper inline than they are as a request.
 */
export type Props = {
  /** `light` is the header arrangement, `dark` the footer's. */
  tone?: 'light' | 'dark';
  class?: string;
};

const { tone = 'light', class: className = 'brand__mark' } = Astro.props;
const ground = tone === 'light' ? 'var(--bone)' : 'var(--green)';
const ink = tone === 'light' ? 'var(--green)' : 'var(--bone)';
---

<svg class={className} viewBox="0 0 2596 2596" aria-hidden="true" focusable="false">
  <rect width="2596" height="2596" fill={ground} />
  <g fill={ink}>
    <rect x="673" y="428" width="1259" height="413" />
    <rect x="857" y="1033" width="403" height="1151" />
    <rect x="1380" y="1033" width="402" height="1151" />
  </g>
</svg>
