---
/**
 * The narrow ask that sits between bands: one line and one button.
 *
 * It is a real section with a real link, not a widget. The pattern layer
 * behind it is decorative and hidden from assistive technology.
 */
import Arrow from '~/components/Arrow.astro';
import Pattern from '~/components/Pattern.astro';

export type Props = {
  /** The line to the left of the button. Short: it is a prompt, not a pitch. */
  line?: string;
  href?: string;
  label?: string;
};

const { line = 'Curious?', href = '/demo/', label = 'Get a demo' } = Astro.props;
---

<section class="askrow" aria-label={label}>
  <Pattern variant="left" />
  <Pattern variant="right" />
  <div class="askrow__inner">
    <p class="askrow__line">{line}</p>
    <a class="btn-os btn-os--accent btn-os--fill" href={href}>
      {label}
      <Arrow />
    </a>
  </div>
</section>
