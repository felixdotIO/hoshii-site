        <g id="vox-drive"><rect x="2.5" y="4.5" width="19" height="12.5" rx="1.75"/><path d="M9 20.5h6M12 17v3.5"/></g>
        <g id="vox-folder"><path d="M3 7a1.75 1.75 0 0 1 1.75-1.75h3.9l2.1 2.6h9.5A1.75 1.75 0 0 1 22 9.6v8.65A1.75 1.75 0 0 1 20.25 20H4.75A1.75 1.75 0 0 1 3 18.25z"/></g>
        <g id="vox-heart"><path d="M12 20.4C10.4 19.2 3.5 14.5 3.5 9.6A4.55 4.55 0 0 1 12 7.05 4.55 4.55 0 0 1 20.5 9.6c0 4.9-6.9 9.6-8.5 10.8Z"/></g>
        <g id="vox-lock"><rect x="4.5" y="10.4" width="15" height="10.1" rx="2.25"/><path d="M8 10.4V7.9a4 4 0 0 1 8 0v2.5"/></g>
        <g id="vox-mail"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.7 6.7 8.3 6.1 8.3-6.1"/></g>
        <g id="vox-money"><circle cx="12" cy="12" r="8.5"/><path d="M15.4 8.7a4.3 4.3 0 1 0 0 6.6"/><path d="M7.6 10.9h5.1M7.6 13.2h5.1"/></g>
