        <g id="vox-search"><circle cx="10.6" cy="10.6" r="6.6"/><path d="m15.4 15.4 5.1 5.1"/></g>
        <g id="vox-sent"><path d="M21 3 3 10.4l7.6 3.1L13.7 21z"/><path d="M21 3 10.6 13.5"/></g>
      </defs>
    </svg>
