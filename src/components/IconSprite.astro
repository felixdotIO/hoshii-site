---
/**
 * Every line icon on the site, defined once.
 *
 * The shapes live in `<defs>`, so nothing here paints; each icon is pulled in
 * where it is used with `<use href="#ico-...">`. That way a motif drawn twenty
 * times on a page costs one definition rather than twenty copies of the path
 * data, and the stroke weight is set once in CSS instead of per instance.
 *
 * Purely decorative, so the sprite is hidden from assistive technology and
 * every `<use>` that references it is too.
 */
---

<svg class="iconsprite" aria-hidden="true" focusable="false">
      <defs>
        <!-- The flow diagram's own set: drawn to one grid, one stroke weight and
             one corner radius, so the six read as a family at 20px. -->
        <g id="ico-mail"><rect x="3.25" y="6" width="17.5" height="12" rx="2.25"/><path d="M4.5 7.4 12 13l7.5-5.6"/></g>
        <g id="ico-chat"><rect x="3.25" y="5.25" width="17.5" height="11.5" rx="2.25"/><path d="M8.1 16.75v3.1l3.7-3.1"/></g>
        <g id="ico-doc"><path d="M6.25 3.5h7.1l4.4 4.4V20a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 4.75 20V5a1.5 1.5 0 0 1 1.5-1.5Z"/><path d="M13.35 3.5v4.4h4.4"/></g>
        <g id="ico-search"><circle cx="10.9" cy="10.9" r="6.4"/><path d="m15.5 15.5 5.25 5.25"/></g>
        <g id="ico-drafted"><rect x="4.75" y="3.5" width="14.5" height="18" rx="1.5"/><path d="M7.9 9h8.2M7.9 12.5h8.2M7.9 16h4.6"/></g>
        <g id="ico-reply"><path d="M9.4 6.6 4 12l5.4 5.4"/><path d="M4 12h8.6a8.15 8.15 0 0 1 8.15 8.15"/></g>
        <g id="vox-bars"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8.2 16.2v-3.8M12 16.2V8.6M15.8 16.2v-5.6"/></g>
        <g id="vox-box"><rect x="3" y="4.5" width="18" height="15" rx="1.75"/><path d="M3 9.4h18M3 14.5h18M9.5 9.4v10.1M15 9.4v10.1"/></g>
        <g id="vox-chat"><path d="M20.5 11.8c0 3.9-3.8 7.1-8.5 7.1-1 0-2-.14-2.9-.4L4 20.5l1.35-3.6C4.1 15.5 3.5 13.7 3.5 11.8c0-3.9 3.8-7.1 8.5-7.1s8.5 3.2 8.5 7.1Z"/></g>
