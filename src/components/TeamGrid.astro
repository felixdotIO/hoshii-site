---
/**
 * Portraits, names and roles. The quote runs only where the person gave one.
 *
 * The photograph is decorative next to the name printed under it — announcing
 * "photo of Daniel Nydegger" straight before the text "Daniel Nydegger" is a
 * duplicate, not a description — so alt is deliberately empty.
 *
 * `Picture`, not `Image`, and that is load-bearing rather than a preference.
 * Four rules in the stylesheet place the portrait with `.doc__person picture`
 * — on the booking and pricing pages it is what makes the photo span both grid
 * rows. A bare `<img>` satisfies none of them, so the portrait took a single
 * cell and pushed the role into the 44px column, where it wrapped mid-phrase.
 * The element is part of the layout contract, not just a wrapper.
 */
import { Picture } from 'astro:assets';
import type { TeamMember } from '~/data/team';

export type Props = {
  members: TeamMember[];
  quotes?: boolean;
  /**
   * How wide the portrait actually renders, per page. It is not decoration:
   * the source files are 580px on the long edge and there is no more than
   * that, so a box the browser thinks is small enough for the 290w file, or a
   * box wider than 290 CSS px on a 2x screen, is a visibly soft portrait. The
   * careers grid renders them near 290; the two booking rails render 52px
   * avatars and should not be pulling the 580w file for them.
   */
  sizes?: string;
};

const {
  members,
  quotes = true,
  sizes = '(min-width: 56em) 18rem, (min-width: 40em) 40vw, 45vw',
} = Astro.props;
---

<ul class="doc__team">
  {
    members.map((member) => (
      <li class="doc__person">
        <Picture
          class="doc__portrait"
          src={member.photo}
          alt=""
          formats={['avif', 'webp']}
          widths={[290, 580]}
          sizes={sizes}
          loading="lazy"
        />
        <p class="doc__personName">{member.name}</p>
        <p class="doc__personRole">{member.role}</p>
        {quotes && member.quote && <blockquote class="doc__personQuote">{member.quote}</blockquote>}
      </li>
    ))
  }
</ul>
