---
/**
 * One customer story in a list.
 *
 * Deliberately spare. It carried the company, the headline, the excerpt, the
 * industry and the system, and the headline and excerpt say the same thing —
 * "High-volume, multilingual order processing on Microsoft Dynamics" over
 * "Over 100 orders a day, in German, French and Thai, prepared for Dynamics
 * automatically". Two sentences of the same claim, plus an industry that
 * repeats across cards, is what made three of these read as a wall of text.
 *
 * The card's job is to be worth opening, not to tell the story. So: whose desk
 * it is, the claim, and the system Hoshii writes into — the fact a reader is
 * scanning for. Everything else is on the page behind it.
 *
 * The whole card is the link and the headline is the link text, so it is never
 * "read more"; the arrow says so and is decorative.
 */
import type { CollectionEntry } from 'astro:content';
import { customerPath } from '~/lib/paths';

export type Props = {
  story: CollectionEntry<'customers'>;
};

const { story } = Astro.props;
const { data } = story;
---

<li class="story__item">
  <a class="story__card" href={customerPath(story)}>
    <span class="story__who">{data.company}</span>
    <span class="story__head">{data.headline}</span>
    <span class="story__foot">
      <span class="story__erp">{data.erp}</span>
      <span class="story__go" aria-hidden="true">→</span>
    </span>
  </a>
</li>
