
---
/**
 * The homepage.
 *
 * The argument in order: what it is, who trusts it, who it is for, a customer
 * saying so, the shift it makes, what it does, how it connects, where the data
 * sits, the questions, the ask. Every section is in the initial HTML — the two
 * scripts at the bottom add a toggle and a hover state to content that is
 * already there, and the page reads completely without either.
 *
 * FAQPage data is carried here because the questions band genuinely is a list
 * of questions and answers, and it is built from the same collection entries
 * the band renders.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import IconSprite from '~/components/IconSprite.astro';
import LogoBelt from '~/components/LogoBelt.astro';
import Faq from '~/components/Faq.astro';
import Cta from '~/components/Cta.astro';
import Pattern from '~/components/Pattern.astro';
import Announce from '~/components/Announce.astro';
import CursorPill from '~/components/CursorPill.astro';
import Closer from '~/components/Closer.astro';
import Arrow from '~/components/Arrow.astro';
import {
  organization,
  website,
  softwareApplication,
  faqPage,
  type QA,
} from '~/lib/schema';

import heroAfter from '~/assets/img/hero-after.jpg';
import heroBefore from '~/assets/img/hero-before.jpg';
import thomasLocher from '~/assets/img/thomas-locher.jpg';
import wheelChat from '~/assets/img/wheel-chat.png';
import closerElevator from '~/assets/img/closer-elevator.png';
import wheelConnectors from '~/assets/img/wheel-connectors.png';
import wheelKnowledge from '~/assets/img/wheel-knowledge.png';
import zurichStrip from '~/assets/img/zurich-strip.jpg';
import freshbooks from '~/assets/integrations/freshbooks.png';
import gmail from '~/assets/integrations/gmail.png';
import hubspot from '~/assets/integrations/hubspot.png';
import n8n from '~/assets/integrations/n8n.png';
import outlook from '~/assets/integrations/outlook.png';
import sap from '~/assets/integrations/sap.png';
import zapier from '~/assets/integrations/zapier.png';

const faqGroups = (await getCollection('faqs', ({ data }) => data.page === 'home')).sort(
  (a, b) => a.data.order - b.data.order
);

const pairs: QA[] = faqGroups.flatMap((group) =>
  group.data.items.map((item) => ({
    question: item.question,
    answer: item.answer.join(' '),
  }))
);
---

<BaseLayout
  title="The AI-native inbox for B2B operations"
  description="Hoshii reads what lands in your team's shared mailboxes, pulls the answer out of your ERP, and prepares the reply or the order for approval. Reply faster, reduce manual work."
  path="/"
  schema={[organization(), website(), softwareApplication(), faqPage(pairs)]}
>
  <Announce
    slot="above-header"
    tag="Operations Forward 26"
    text="If your inbox runs your day, join us in Zürich on 23 September."
    href="https://luma.com/rddz10p7"
  />

  <IconSprite />

  <!-- Hero — copy left, the product right ----------------------------- -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title" id="hero-title">
          The intelligent inbox<br />
          <em
            ><span style="--w: 0">that</span> <span style="--w: 1">keeps</span>
            <span style="--w: 2">work</span> <span style="--w: 3">moving.</span></em
          >
        </h1>

        <p class="hero__sub">
          Hoshii is the AI&#8209;native inbox for B2B operations that
          proactively gets better every day. Reply faster, reduce manual
          work.
        </p>

        <a class="btn-os btn-os--accent btn-os--fill btn-os--lg" href="/demo/">Book a demo<span class="btn-os__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3.2 8h9M8.6 4.4 12.2 8l-3.6 3.6"/></svg></span></a>
      </div>

      <div class="hero__show">
      <div class="hero__frame" data-show="before">
        <Image src={heroBefore} class="hero__shot hero__shot--before" alt="Five people at an order desk, paper flying around them" widths={[640, 960, 1254, 1880]} sizes="(min-width: 64em) 46rem, 100vw" />
        <Image src={heroAfter} class="hero__shot hero__shot--after" alt="The same five people at the same desk, the paper gone" loading="lazy" widths={[640, 960, 1254, 1880]} sizes="(min-width: 64em) 46rem, 100vw" />
      <div class="hero__gauge" role="group" aria-label="With and without Hoshii">
        <button class="hero__state" type="button" data-state="after" aria-pressed="false">With Hoshii</button>
        <button class="hero__state is-on" type="button" data-state="before" aria-pressed="true">Without Hoshii</button>
      </div>
      </div>
    </div>

    </div>
  </section>

  <!-- Logo strip ------------------------------------------------------ -->
  {/* `proof--rolling` carries the animation. In the static build a script
      added it after cloning the track; both copies are in the HTML here, so
      the class is too. */}
  <section class="proof proof--rolling" aria-label="Customers">
    <p class="proof__label">
      Trusted by <span class="proof__count">500+</span> B2B operations teams
    </p>
    <LogoBelt variant="proof" label="Companies running Hoshii" />
  </section>

  <!-- Pitch band ------------------------------------------------------ -->
  <section class="pitch guides" aria-labelledby="pitch-text">
    <div class="pitch__panel">
      <Pattern />
      <div class="pitch__lede">
        <p class="pitch__text" id="pitch-text">
        <span class="pitch__brand">Hoshii</span> is the AI&#8209;native inbox for B2B operations. It
        connects to your internal data sources, proactively drafts
        client&#8209;specific replies, suggest areas of improvement and take
        care of the repetitive but necessary work in your day.
      </p>
        <p class="pswap" id="pswap-1" data-role="1">
          <span class="pswap__cue">At the order desk, Hoshii is for you if&hellip;</span>
          hundreds of mails land in the shared inbox and your own, and half the week goes on work that never quite feels productive.
        </p>
        <p class="pswap" id="pswap-2" data-role="2">
          <span class="pswap__cue">In sales, Hoshii is for you if&hellip;</span>
          requests stack up while you are in calls, and the quote that takes ten minutes to write is the one that waits two days.
        </p>
        <p class="pswap" id="pswap-3" data-role="3">
          <span class="pswap__cue">In customer service, Hoshii is for you if&hellip;</span>
          the same questions come in all day, the history sits in five different tools, and the hard cases wait while you answer the easy ones again.
        </p>
        <p class="pswap" id="pswap-4" data-role="4">
          <span class="pswap__cue">In legal, Hoshii is for you if&hellip;</span>
          contracts and NDAs arrive as mail attachments, and every one gets checked against the same clauses you checked last week.
        </p>
        <p class="pswap" id="pswap-5" data-role="5">
          <span class="pswap__cue">In finance, Hoshii is for you if&hellip;</span>
          invoice copies, payment queries and the dunning run all share one inbox, and a good part of the month goes on chasing instead of closing.
        </p>
        <p class="pswap" id="pswap-6" data-role="6">
          <span class="pswap__cue">Leading the desk, Hoshii is for you if&hellip;</span>
          you run the desk on what people tell you, and the first sign of a problem is usually the customer chasing it.
        </p>
      </div>

      <ul class="pitch__roles">
        <li class="prole-cell">
          <a class="prole" href="/demo/" data-role="1"
                  aria-describedby="pswap-1"
                  style="--bx:18%;--by:24%;--bloom:rgba(196,78,44,.30);--shot:url('/assets/img/prof-orderdesk.jpg')">
            <span class="prole__ico" aria-hidden="true">
              <svg class="vox" viewBox="0 0 24 24"><use href="#vox-doc"/></svg>
            </span>
            <span class="prole__label">Order desk &amp; inbound sales</span>
          </a>
        </li>
        <li class="prole-cell">
          <a class="prole" href="/demo/" data-role="2"
                  aria-describedby="pswap-2"
                  style="--blur:3px;--bx:78%;--by:22%;--bloom:rgba(214,150,90,.24);--shot:url('/assets/img/prof-sales.jpg')">
            <span class="prole__ico" aria-hidden="true">
              <svg class="vox" viewBox="0 0 24 24"><use href="#vox-sent"/></svg>
            </span>
            <span class="prole__label">Sales &amp; account management</span>
          </a>
        </li>
        <li class="prole-cell">
          <a class="prole" href="/demo/" data-role="3"
                  aria-describedby="pswap-3"
                  style="--bx:26%;--by:74%;--bloom:rgba(148,164,140,.24);--shot:url('/assets/img/prof-service.jpg')">
            <span class="prole__ico" aria-hidden="true">
              <svg class="vox" viewBox="0 0 24 24"><use href="#vox-chat"/></svg>
            </span>
            <span class="prole__label">Customer service</span>
          </a>
        </li>
        <li class="prole-cell">
          <a class="prole" href="/demo/" data-role="4"
                  aria-describedby="pswap-4"
                  style="--bx:72%;--by:70%;--bloom:rgba(160,140,190,.20);--shot:url('/assets/img/prof-legal.jpg')">
            <span class="prole__ico" aria-hidden="true">
              <svg class="vox" viewBox="0 0 24 24"><use href="#vox-doc"/></svg>
            </span>
            <span class="prole__label">Legal teams</span>
          </a>
        </li>
        <li class="prole-cell">
          <a class="prole" href="/demo/" data-role="5"
                  aria-describedby="pswap-5"
                  style="--bx:22%;--by:40%;--bloom:rgba(196,78,44,.22);--shot:url('/assets/img/prof-finance.jpg')">
            <span class="prole__ico" aria-hidden="true">
              <svg class="vox" viewBox="0 0 24 24"><use href="#vox-money"/></svg>
            </span>
            <span class="prole__label">Finance &amp; accounts receivable</span>
          </a>
        </li>
        <li class="prole-cell">
          <a class="prole" href="/demo/" data-role="6"
                  aria-describedby="pswap-6"
                  style="--blur:3px;--bx:76%;--by:46%;--bloom:rgba(120,150,170,.22);--shot:url('/assets/img/prof-leads.jpg')">
            <span class="prole__ico" aria-hidden="true">
              <svg class="vox" viewBox="0 0 24 24"><use href="#vox-bars"/></svg>
            </span>
            <span class="prole__label">Team leads &amp; operations</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Testimonial ----------------------------------------------------- -->
  <section class="quote guides" aria-labelledby="quote-text">
    <figure class="quote__inner">
      <blockquote class="quote__text" id="quote-text">
        &ldquo;The 2 to 3 hours a day we used to process orders have been
        <em>cut in half</em>. New joiners also have impact significantly
        faster.&rdquo;
      </blockquote>

      <figcaption class="quote__card">
        <span class="quote__well">
          <Image src={thomasLocher} class="quote__portrait" alt="" loading="lazy" />
        </span>
        <span class="quote__who">
          <span class="quote__name">Thomas Locher</span>
          <span class="quote__role">Head of Sales, Max Schwarz AG</span>
        </span>
      </figcaption>
    </figure>
  </section>
  <section class="shift guides" aria-labelledby="shift-title">
    <div class="shift__inner">
      <header class="shift__head">
        <h2 class="shift__title" id="shift-title">
          Stop being busy,
          <em>start being productive.</em>
        </h2>
      </header>

      <div class="shift__pair">
        <!-- Today: a line that never closes ---------------------------- -->
        <article class="shift__card">
          <h3 class="shift__label">Without Hoshii</h3>
          <div class="shift__art shift__art--today" data-anim>
            <p class="shift__count">
              <span class="shift__num">7+</span>
              steps, four tools
            </p>
            <div class="today" aria-hidden="true">
              <div class="today__rail">
                <div class="today__belt">
                <ol class="today__chips">
                  <li class="today__chip">Open email</li>
                  <li class="today__chip">Read the order</li>
                  <li class="today__chip">Look up customer</li>
                  <li class="today__chip">Retype lines</li>
                  <li class="today__chip">Post to systems of record</li>
                  <li class="today__chip">Write confirmation</li>
                  <li class="today__chip">Send</li>
                </ol>
                <ol class="today__chips" aria-hidden="true">
                  <li class="today__chip">Open email</li>
                  <li class="today__chip">Read the order</li>
                  <li class="today__chip">Look up customer</li>
                  <li class="today__chip">Retype lines</li>
                  <li class="today__chip">Post to systems of record</li>
                  <li class="today__chip">Write confirmation</li>
                  <li class="today__chip">Send</li>
                </ol>
                </div>
              </div>

              <div class="today__stack">
                <div class="today__sheet today__sheet--c"></div>
                <div class="today__sheet today__sheet--b"></div>
                <div class="today__sheet today__sheet--a">
                  <p class="today__sheet-title">Order &middot; 4417</p>
                  <span class="today__bar" style="--w: 82%"></span>
                  <span class="today__bar" style="--w: 64%"></span>
                  <span class="today__bar" style="--w: 74%"></span>
                  <span class="today__bar" style="--w: 48%"></span>
                  <span class="today__bar" style="--w: 70%"></span>
                </div>
              </div>
            </div>
          </div>

          <p class="shift__body">
            Open the mail, look up the customer, check stock, retype the
            lines, post to the systems of record. Held together by whoever has
            done it longest, and nothing you fix today makes tomorrow faster.
          </p>
        </article>

        <!-- With Hoshii: everything converges -------------------------- -->
        <article class="shift__card">
          <h3 class="shift__label">
            <span class="shift__badge" aria-hidden="true">
              <svg viewBox="0 0 1259 1756" fill="currentColor">
                <rect x="0" y="0" width="1259" height="413"/>
                <rect x="184" y="605" width="403" height="1151"/>
                <rect x="707" y="605" width="402" height="1151"/>
              </svg>
            </span>
            With Hoshii
          </h3>
          <div class="shift__art shift__art--flow" data-anim>
            <Pattern />
            <p class="shift__count">
              <span class="shift__num">One</span>
              unified workspace
            </p>
            <div class="flow" aria-hidden="true">
              <svg class="flow__glow" viewBox="0 0 400 285">
                <defs>
                  <linearGradient id="flow-in" x1="0" x2="1" y1="0" y2="0">
                    <stop offset="0" stop-color="#fd4b00" stop-opacity=".12"/>
                    <stop offset=".45" stop-color="#fd4b00" stop-opacity=".06"/>
                    <stop offset="1" stop-color="#fd4b00" stop-opacity="0"/>
                  </linearGradient>
                  <linearGradient id="flow-out" x1="1" x2="0" y1="0" y2="0">
                    <stop offset="0" stop-color="#ffffff" stop-opacity=".2"/>
                    <stop offset=".45" stop-color="#e8f0e4" stop-opacity=".11"/>
                    <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
                  </linearGradient>
                  <radialGradient id="flow-core">
                    <stop offset="0" stop-color="#ffffff" stop-opacity=".95"/>
                    <stop offset=".5" stop-color="#ffffff" stop-opacity=".45"/>
                    <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
                  </radialGradient>
                  <filter id="flow-soft" x="-25%" y="-35%" width="150%" height="170%" color-interpolation-filters="sRGB">
                    <feGaussianBlur stdDeviation="9"/>
                  </filter>
                </defs>
                <g filter="url(#flow-soft)">
                  <path d="M-14 6c74 0 128 92 196 112v39C114 177 60 279-14 279Z" fill="url(#flow-in)"/>
                  <path d="M414 6c-74 0-128 92-196 112v39c68 20 122 122 196 122Z" fill="url(#flow-out)"/>
                  <ellipse cx="200" cy="142.5" rx="86" ry="50" fill="url(#flow-core)"/>
                </g>
              </svg>

              <svg class="flow__wires" viewBox="0 0 400 285">
                <g class="flow__lines">
                  <path d="M87 57C124 57 130 142.5 161 142.5"/>
                  <path d="M87 142.5H161"/>
                  <path d="M87 228C124 228 130 142.5 161 142.5"/>
                  <path d="M239 142.5C270 142.5 276 57 313 57"/>
                  <path d="M239 142.5H313"/>
                  <path d="M239 142.5C270 142.5 276 228 313 228"/>
                </g>
                {/* One short dash per wire. Quieter than anything that carries a
                    payload, and the only thing on this panel that moves. */}
                <g class="flow__pulses">
                  <path d="M87 57C124 57 130 142.5 161 142.5" style="--d: 0s" pathLength="100"/>
                  <path d="M87 142.5H161" style="--d: 1.267s" pathLength="100"/>
                  <path d="M87 228C124 228 130 142.5 161 142.5" style="--d: 2.533s" pathLength="100"/>
                  <path d="M239 142.5C270 142.5 276 57 313 57" style="--d: .633s" pathLength="100"/>
                  <path d="M239 142.5H313" style="--d: 1.9s" pathLength="100"/>
                  <path d="M239 142.5C270 142.5 276 228 313 228" style="--d: 3.167s" pathLength="100"/>
                </g>
              </svg>

              <p class="flow__tile flow__tile--i1">
                <span class="flow__glyph">
                  <svg class="vox" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-mail" transform="translate(12 12) scale(1.0740) translate(-12.00 -12.00)" stroke-width="1.397"/></svg>
                </span>
              </p>
              <p class="flow__tile flow__tile--i2">
                <span class="flow__glyph">
                  <svg class="vox" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-chat" transform="translate(12 12) scale(1.0000) translate(-12.00 -12.55)" stroke-width="1.500"/></svg>
                </span>
              </p>
              <p class="flow__tile flow__tile--i3">
                <span class="flow__glyph">
                  <svg class="vox" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-doc" transform="translate(12 12) scale(1.0266) translate(-11.25 -12.50)" stroke-width="1.461"/></svg>
                </span>
              </p>

              <p class="flow__core">
                <svg class="flow__mark" viewBox="0 0 1259 1756" fill="currentColor">
                  <rect x="0" y="0" width="1259" height="413"/>
                  <rect x="184" y="605" width="403" height="1151"/>
                  <rect x="707" y="605" width="402" height="1151"/>
                </svg>
              </p>

              <p class="flow__tile flow__tile--o1">
                <span class="flow__glyph">
                  <svg class="vox" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-money"/></svg>
                </span>
              </p>
              <p class="flow__tile flow__tile--o2">
                <span class="flow__glyph">
                  <svg class="vox" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-smile"/></svg>
                </span>
              </p>
              <p class="flow__tile flow__tile--o3">
                <span class="flow__glyph">
                  <svg class="vox" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-clock"/></svg>
                </span>
              </p>
            </div>
          </div>

          <p class="shift__body">
            Hoshii is the AI&#8209;native inbox for B2B operations.
            Every channel lands in one place with the work already started:
            context looked up, order drafted, reply written. You approve, it
            learns, and because
            <strong>one system covers the flow end to end</strong> the gains
            compound instead of stopping at every handover.
          </p>
        </article>
      </div>
    </div>
  </section>
  <!-- How it works — the sequence, in order ---------------------------- -->
  <!-- Three capabilities, replacing the six-step sequence -->
  <section class="caps guides" id="product" aria-labelledby="caps-title">
    <div class="caps__inner">
      <header class="caps__head">
        <h2 class="caps__title" id="caps-title">
          Your team stops sorting and re&#8209;typing.
          <em>It starts deciding.</em>
        </h2>
      </header>

      <article class="cap" data-tone="a">
      <div class="cap__copy">
        <h3 class="cap__head">We organize your inbox</h3>
        <p class="cap__lead">Every arriving email is read, placed, and given the facts it needs, pulled from your connected tools with read access only.</p>
        <ul class="cap__points">
          <li class="cap__point">
            <h4 class="cap__pname">Connected in a second</h4>
            <p class="cap__ptext">Gmail or Outlook SSO. No migration, no new address. Shared stays shared, private stays private until you choose to share it.</p>
          </li>
          <li class="cap__point">
            <h4 class="cap__pname">Sorted before you open it</h4>
            <p class="cap__ptext">Orders, complaints, new customers: each classified, prioritised, and dropped into the workspace that already owns it.</p>
          </li>

        </ul>
      </div>

      <div class="cap__art">
        <Pattern />
      <div class="sortart" data-anim aria-hidden="true">
        <div class="inbox">
          <p class="inbox__bar">
            <span class="inbox__logo"><svg class="hub__mark" viewBox="0 0 1259 1756" fill="currentColor"><rect x="0" y="0" width="1259" height="413"/><rect x="184" y="605" width="403" height="1151"/><rect x="707" y="605" width="402" height="1151"/></svg></span>Unibox
          </p>
          <div class="inbox__body"></div>
        </div>
        <ul class="lanes">
            <li class="lane" style="--i:0;--dir:1;--r:0">
              <p class="lane__name">Order desk</p>
              <div class="lane__slot">
                <div class="lmail">
                  <span class="lmail__who">Meier AG</span>
                  <span class="lmail__tag lmail__tag--order">Order</span>
                </div>
              </div>
            </li>
            <li class="lane" style="--i:1;--dir:0;--r:1">
              <p class="lane__name">Service</p>
              <div class="lane__slot">
                <div class="lmail">
                  <span class="lmail__who">Brauer &amp; Co</span>
                  <span class="lmail__tag lmail__tag--issue">Complaint</span>
                </div>
              </div>
            </li>
            <li class="lane" style="--i:2;--dir:-1;--r:2">
              <p class="lane__name">Sales</p>
              <div class="lane__slot">
                <div class="lmail">
                  <span class="lmail__who">Nyffeler AG</span>
                  <span class="lmail__tag lmail__tag--new">New customer</span>
                </div>
              </div>
            </li>
        </ul>
      </div>
      </div>
    </article>

    <article class="cap cap--flip" data-tone="b">
      <div class="cap__copy">
        <h3 class="cap__head">We find the context and anticipate what&rsquo;s next</h3>
        <p class="cap__lead">Replies arrive drafted, lookups done. Quiet quotes come back as a proposed follow-up, missing details get chased. Proposed first, always.</p>
        <ul class="cap__points">
          <li class="cap__point">
            <h4 class="cap__pname">Drafted in your voice</h4>
            <p class="cap__ptext">Past threads set the tone. Nothing sends itself.</p>
          </li>
          <li class="cap__point">
            <h4 class="cap__pname">Chat with your data</h4>
            <p class="cap__ptext">Ask what is unanswered. Nothing leaves the company.</p>
          </li>
          <li class="cap__point">
            <h4 class="cap__pname">Nothing goes quiet</h4>
            <p class="cap__ptext">A conversation that stalls comes back to you, already written. Nothing for you to remember.</p>
          </li>
          <li class="cap__point">
            <h4 class="cap__pname">Ask before you approve</h4>
            <p class="cap__ptext">Ask why it drafted that, or where a date came from. It answers from the sources it used.</p>
          </li>
        </ul>
      </div>

      <div class="cap__art">
        <Pattern />
      <div class="suckart" aria-hidden="true">
        <div class="suckart__field">
          <span class="item shot shot--knowledge" style="--i:0"><Image src={wheelKnowledge} alt="" loading="lazy" /></span>
          <span class="item logo logo--a" style="--i:1"><Image src={gmail} alt="" loading="lazy" /></span>
          <span class="item shot shot--conn" style="--i:2"><Image src={wheelConnectors} alt="" loading="lazy" /></span>
          <span class="item logo logo--b" style="--i:3"><Image src={sap} alt="" loading="lazy" /></span>
