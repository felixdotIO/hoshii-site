---
/**
 * The order processing page.
 *
 * The one product page that exists in this build, and the live site's primary
 * nav link, so /order-processing-skill 301s onto it.
 *
 * It carries FAQPage data because the "Common questions" section genuinely is
 * a list of questions and answers, and it is built from the same collection
 * entries the section renders.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import DocLayout from '~/layouts/DocLayout.astro';
import SkillFlow from '~/components/SkillFlow.astro';
import FaqGroups from '~/components/FaqGroups.astro';
import Arrow from '~/components/Arrow.astro';
import { faqPage, softwareApplication, type QA } from '~/lib/schema';
import dock from '~/assets/skill/dock.jpg';

const groups = (await getCollection('faqs', ({ data }) => data.page === 'order-processing')).sort(
  (a, b) => a.data.order - b.data.order
);

const pairs: QA[] = groups.flatMap((group) =>
  group.data.items.map((item) => ({
    question: item.question,
    answer: item.answer.join(' '),
  }))
);

const FORMATS = [
  { lead: 'PDF and scans', rest: ', including layouts that change every time' },
  { lead: 'Email text', rest: ', forwarded threads, the order buried three replies down' },
  { lead: 'Excel and CSV', rest: ', whatever the column order' },
  { lead: 'Voicemail and audio', rest: ', transcribed before anyone has to listen' },
  { lead: 'Photographs', rest: ', including handwriting' },
];

const MATCHES = [
  {
    customer: 'A. & B. Rinderknecht',
    arrived: '20× Schrauben, kurz',
    means: 'Hex bolt M8×18',
    sku: '4471',
  },
  {
    customer: 'Berger Industrietechnik',
    arrived: '20× Schrauben, kurz',
    means: 'Wood screw 4×30',
    sku: '7720',
  },
];

const SURFACES = [
  {
    head: 'Tagged the moment it lands',
    body: 'Order, request for quote, complaint or noise, sorted as it arrives, in any format or language. Tags, Open or Done status and folders, all inside Outlook.',
    shot: '/assets/img/prof-orderdesk.jpg',
    bloom: 'rgba(196, 78, 44, 0.28)',
  },
  {
    head: 'Processed in a pop‑up',
    body: 'The order opens beside the mail, structured and ready to check. One confirmation posts it to the ERP and marks the thread done.',
    shot: '/assets/img/prof-service.jpg',
    bloom: 'rgba(148, 164, 140, 0.24)',
  },
];
---

<DocLayout
  title="Order processing"
  description="Hoshii reads inbound B2B orders from PDF, email, Excel, voicemail and handwriting, matches every line to your ERP, and prepares the entry for approval."
  path="/order-processing/"
  sub="Every inbound order, read and prepared, "
  accent="before anyone opens it."
  trail={[{ label: 'Order processing', href: '/order-processing/' }]}
  pageClass="page--order-processing"
  wide={true}
  schema={[softwareApplication(), faqPage(pairs)]}
>
  <p class="doc__note">Shipped Skill · live on 500+ order desks</p>

  <SkillFlow />

  <h2 id="it-reads-whatever-arrived">It reads whatever arrived</h2>
  <p>
    Your customers do not send clean data. The Skill reads the order out of
    <strong>PDFs, forwarded email threads, Excel sheets, voicemails and
    photographs of handwriting</strong>, in any of the languages your desk works
    in.
  </p>
  <ul class="doc__checks">
    {FORMATS.map((format) => <li><strong>{format.lead}</strong>{format.rest}</li>)}
  </ul>
  <p class="doc__note">
    A PDF reading “bitte liefern Sie zur KW 22: 12× Palette Mehl Type 405, 8×
    Karton Rapsöl 10 L” comes out as two lines with quantities attached. So does
    the voicemail that says the same thing out loud.
  </p>

  <h2 id="it-matches-lines-to-your-products">It matches lines to your products</h2>
  <p>
    Reading it is the easy half. Every extracted line is matched to the right
    product in your ERP and prepared as a clean entry. Your team confirms.
    <strong>No rekeying, no second screen.</strong>
  </p>
  <div class="ptable__wrap">
    <table class="ptable">
      <thead>
        <tr>
          <th scope="col">The same words, two customers</th>
          <th scope="col">What arrived</th>
          <th scope="col">What it means</th>
          <th scope="col">SKU</th>
        </tr>
      </thead>
      <tbody>
        {
          MATCHES.map((row) => (
            <tr>
              <th scope="row">{row.customer}</th>
              <td>{row.arrived}</td>
              <td>{row.means}</td>
              <td>{row.sku}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <blockquote class="lift">
    <p class="lift__text">
      The same three words meant two different products. Nobody wrote a rule for
      that.
    </p>
  </blockquote>

  <h2 id="it-learns-what-each-customer-means">It learns what each customer means</h2>
  <p>
    Every confirmation teaches the Skill how a given customer orders, and it
    applies that from the next order on. This is procedural knowledge: not a
    model that guesses better in general, but one that knows
    <strong>how your customers actually write</strong>. You can see it running on
    real desks in the <a href="/customers/">customer stories</a>.
  </p>
  <figure class="doc__shot">
    <Image
      src={dock}
      alt="Pallets moving on a loading dock at first light"
      widths={[700, 1400]}
      sizes="(min-width: 60em) 44rem, 100vw"
      loading="lazy"
    />
  </figure>

  <h2 id="it-runs-inside-outlook-and-gmail">It runs inside Outlook and Gmail</h2>
  <p>
    Nobody has to move. The Skill runs as a
    <strong>native add‑in for Outlook and Gmail</strong>, so the work appears
    where the mail already lands. No new tool, no migration, no second login.
  </p>
  <ul class="doc__panels">
    {
      SURFACES.map((surface) => (
        <li class="doc__panel" style={`--shot: url('${surface.shot}'); --bloom: ${surface.bloom}`}>
          <h3 class="doc__panelHead">{surface.head}</h3>
          <p class="doc__panelBody">{surface.body}</p>
        </li>
      ))
    }
  </ul>

  <FaqGroups groups={groups} />

  <aside class="docend">
    <p class="docend__head">
      Bring your most complex order. We will show you what happens to it, live,
      in 30 minutes.
    </p>
    <a class="btn-os btn-os--fill btn-os--lg" href="/demo/">
      Book a demo
      <Arrow />
    </a>
  </aside>
</DocLayout>
