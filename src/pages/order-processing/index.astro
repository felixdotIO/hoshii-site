---
/**
 * The order processing page.
 *
 * The one product page in this build, and the live site's primary nav link,
 * so /order-processing-skill 301s onto it.
 *
 * Built in bands rather than as one column of prose, on the same device as
 * the pricing page. The page makes four separate claims — it reads anything,
 * it matches lines, it learns a customer, it runs where the mail already is —
 * and as a single scroll they ran together into one undifferentiated document.
 * A band gives each claim its own ground, its own air and a rule across the
 * full width, so the page reads as four arguments rather than one long one.
 *
 * The proof band carries the client marks and three customer stories. No
 * figure on this page is new: the stories say what they say, and the page
 * links to them rather than restating them.
 *
 * FAQPage data is carried because the questions band genuinely is a list of
 * questions and answers, built from the same entries the band renders.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DocMasthead from '~/components/DocMasthead.astro';
import FaqGroups from '~/components/FaqGroups.astro';
import LogoBelt from '~/components/LogoBelt.astro';
import CaseRefs from '~/components/CaseRefs.astro';
import Pattern from '~/components/Pattern.astro';
import { CLIENTS } from '~/data/clients';
import outlook from '~/assets/integrations/outlook.png';
import Arrow from '~/components/Arrow.astro';
import {
  organization,
  website,
  softwareApplication,
  faqPage,
  breadcrumbs,
  type QA,
} from '~/lib/schema';
import dock from '~/assets/skill/dock.jpg';

const path = '/order-processing/';
const trail = [
  { label: 'Home', href: '/' },
  { label: 'Order processing', href: path },
];

const groups = (await getCollection('faqs', ({ data }) => data.page === 'order-processing')).sort(
  (a, b) => a.data.order - b.data.order
);

const pairs: QA[] = groups.flatMap((group) =>
  group.data.items.map((item) => ({
    question: item.question,
    answer: item.answer.join(' '),
  }))
);

const stories = (await getCollection('customers', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const FORMATS = [
  { lead: 'PDF and scans', rest: ', including layouts that change every time' },
  { lead: 'Email text', rest: ', forwarded threads, the order buried three replies down' },
  { lead: 'Excel and CSV', rest: ', whatever the column order' },
  { lead: 'Voicemail and audio', rest: ', transcribed before anyone has to listen' },
  { lead: 'Photographs', rest: ', including handwriting' },
];

const MATCHES = [
  {
    customer: 'A. & B. Rinderknecht',
    arrived: '20× Schrauben, kurz',
    means: 'Hex bolt M8×18',
    sku: '4471',
  },
  {
    customer: 'Berger Industrietechnik',
    arrived: '20× Schrauben, kurz',
    means: 'Wood screw 4×30',
    sku: '7720',
  },
];

/** Named desks running this Skill. Each is on the customer list already. */
const USERS = CLIENTS.filter((c) => ['schuetzengarten', 'stutzer', 'chiefs'].includes(c.key));

/** Where a reader of this page actually wants to go next. */
const NEXT = [
  {
    title: 'What it costs',
    blurb:
      'What sets the number: how much mail lands, in how many inboxes, and which systems Hoshii writes into.',
    label: 'Pricing',
    href: '/pricing/',
  },
  {
    title: 'Desks running it',
    blurb:
      'Three order desks at three very different volumes, each writing into a different ERP.',
    label: 'Customer stories',
    href: '/customers/',
  },
  {
    title: 'The rest of the questions',
    blurb:
      'What Hoshii connects to, where the data lives, and what it takes to start.',
    label: 'Questions',
    href: '/faq/',
  },
];

const SURFACES = [
  {
    head: 'Tagged the moment it lands',
    body: 'Order, request for quote, complaint or noise, sorted as it arrives, in any format or language. Tags, Open or Done status and folders, all inside Outlook.',
    shot: '/assets/img/prof-orderdesk.jpg',
    bloom: 'rgba(196, 78, 44, 0.28)',
  },
  {
    head: 'Processed in a pop‑up',
    body: 'The order opens beside the mail, structured and ready to check. One confirmation posts it to the ERP and marks the thread done.',
    shot: '/assets/img/prof-service.jpg',
    bloom: 'rgba(148, 164, 140, 0.24)',
  },
];
---

<BaseLayout
  title="Order processing"
  description="Hoshii reads inbound B2B orders from PDF, email, Excel, voicemail and handwriting, matches every line to your ERP, and prepares the entry for approval."
  path={path}
  mainClass="doc page--order-processing doc--wide"
  schema={[
    organization(),
    website(),
    breadcrumbs(trail),
    softwareApplication(),
    faqPage(pairs),
  ]}
>
  <DocMasthead
    title="Order processing"
    sub="Every inbound order, read and prepared, "
    accent="before anyone opens it."
  />

  {/* Copy left, the work itself on the right — the shape the homepage uses for
      every capability, so the product page opens the way the site argues
      everywhere else. */}
  <section class="pband guides" aria-labelledby="what-it-does">
    <div class="doc__inner doc__body pband__inner">
      <article class="cap">
        <div class="cap__copy">
          <p class="skill__badge">Shipped Skill · live on 500+ order desks</p>

          {/* The band had no dominant element: a small note, a paragraph of
              caption-grey body copy, and some logos. The claim is split into a
              statement and its support now, on the same two type sizes the
              home page gives every capability, so the column has a top. */}
          <h2 class="cap__head" id="what-it-does">
            An inbound order becomes a <em>ready‑to‑post ERP entry.</em>
          </h2>
          <p class="cap__lead">
            It reads the order out of whatever arrived, matches every line to
            your products, and hands your team one thing to confirm.
          </p>

          <p class="skillby__cap">Running this Skill</p>
          <ul class="skillby">
            {
              USERS.map((client) => (
                <li>
                  <Image
                    class={`proof__logo proof__logo--${client.key} proof__logo--${client.ink}`}
                    src={client.src}
                    alt={client.name}
                    widths={[300, 480]}
                    sizes="150px"
                    loading="lazy"
                  />
                </li>
              ))
            }
          </ul>
        </div>

        <div class="cap__art">
          <Pattern />

          {/* The hard case, not the easy one. A mail that spells out every
              line is not the problem an order desk has — "the usual, next
              Wednesday" is, because answering it means knowing what this
              customer always orders and which Wednesday they mean. So the
              mail is vague, the resolution is shown, and the ERP is its own
              window opening beside it rather than a panel in the same card. */}
          <div class="deskart" data-anim>
            <div class="win win--mail">
              <p class="win__bar">
                <span class="win__dots" aria-hidden="true"></span>
                <Image src={outlook} alt="" widths={[64, 128]} sizes="14px" loading="lazy" />
                <span class="win__name">Outlook</span>
              </p>

              <div class="win__body">
                <p class="mail__meta">
                  <span class="mail__dot" aria-hidden="true">B</span>
                  <span class="mail__who">Berger Industrietechnik</span>
                  <span class="mail__when">09:12</span>
                </p>
                <p class="mail__subj">Order</p>
                <p class="mail__text">
                  Hi, next Wednesday the usual again please. Many thanks!
                </p>
                <p class="mail__actions" aria-hidden="true">
                  <span>Reply</span><span>Reply all</span><span>Forward</span>
                </p>
              </div>
            </div>

            {/* The two things a person would have had to know. */}
            <ul class="resolve">
              <li style="--i:0">
                <span class="resolve__said">“the usual”</span>
                <span class="resolve__to" aria-hidden="true">→</span>
                <span class="resolve__means">their standing two lines</span>
              </li>
              <li style="--i:1">
                <span class="resolve__said">“next Wednesday”</span>
                <span class="resolve__to" aria-hidden="true">→</span>
                <span class="resolve__means">delivery week 22</span>
              </li>
            </ul>

            <div class="win win--erp">
              <p class="win__bar">
                <span class="win__dots" aria-hidden="true"></span>
                <span class="win__name">ERP · Order entry</span>
                <span class="win__tag">draft</span>
              </p>

              <div class="win__body">
                <ul class="erp__lines">
                  <li>
                    <span class="erp__item">Flour type 405</span>
                    <span class="erp__qty">12 pallets</span>
                  </li>
                  <li>
                    <span class="erp__item">Rapeseed oil 10 L</span>
                    <span class="erp__qty">8 cartons</span>
                  </li>
                </ul>
                <p class="erp__foot">
                  <span class="erp__when">Delivery week 22</span>
                  <span class="erp__btn">Confirm</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="pband guides" aria-labelledby="it-reads-whatever-arrived">
    <div class="doc__inner doc__body pband__inner">
      <h2 id="it-reads-whatever-arrived">It reads whatever arrived</h2>
      <p>
        Your customers do not send clean data. The Skill reads the order out of
        <strong>PDFs, forwarded email threads, Excel sheets, voicemails and
        photographs of handwriting</strong>, in any of the languages your desk
        works in.
      </p>
      <ul class="doc__checks">
        {FORMATS.map((format) => <li><strong>{format.lead}</strong>{format.rest}</li>)}
      </ul>
      <p class="doc__note">
        A PDF reading “bitte liefern Sie zur KW 22: 12× Palette Mehl Type 405, 8×
        Karton Rapsöl 10 L” comes out as two lines with quantities attached. So
        does the voicemail that says the same thing out loud.
      </p>
    </div>
  </section>

  <section class="pband guides" aria-labelledby="it-matches-lines-to-your-products">
    <div class="doc__inner doc__body pband__inner">
      <h2 id="it-matches-lines-to-your-products">It matches lines to your products</h2>
      <p>
        Reading it is the easy half. Every extracted line is matched to the right
        product in your ERP and prepared as a clean entry. Your team confirms.
        <strong>No rekeying, no second screen.</strong>
      </p>
      <div class="ptable__wrap">
        <table class="ptable">
          <thead>
            <tr>
              <th scope="col">The same words, two customers</th>
              <th scope="col">What arrived</th>
              <th scope="col">What it means</th>
              <th scope="col">SKU</th>
            </tr>
          </thead>
          <tbody>
            {
              MATCHES.map((row) => (
                <tr>
                  <th scope="row">{row.customer}</th>
                  <td>{row.arrived}</td>
                  <td>{row.means}</td>
                  <td>{row.sku}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <blockquote class="lift">
        <p class="lift__text">
          The same three words meant two different products. Nobody wrote a rule
          for that.
        </p>
      </blockquote>
    </div>
  </section>

  <section class="pband guides" aria-labelledby="it-learns-what-each-customer-means">
    <div class="doc__inner doc__body pband__inner">
      <h2 id="it-learns-what-each-customer-means">It learns what each customer means</h2>
      <p>
        Every confirmation teaches the Skill how a given customer orders, and it
        applies that from the next order on. This is procedural knowledge: not a
        model that guesses better in general, but one that knows
        <strong>how your customers actually write</strong>.
      </p>
      <figure class="doc__shot">
        <Image
          src={dock}
          alt="Pallets moving on a loading dock at first light"
          widths={[700, 1400]}
          sizes="(min-width: 60em) 44rem, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="pband guides" aria-labelledby="it-runs-inside-outlook-and-gmail">
    <div class="doc__inner doc__body pband__inner">
      <h2 id="it-runs-inside-outlook-and-gmail">It runs inside Outlook and Gmail</h2>
      <p>
        Nobody has to move. The Skill runs as a
        <strong>native add‑in for Outlook and Gmail</strong>, so the work appears
        where the mail already lands. No new tool, no migration, no second login.
      </p>
      <ul class="doc__panels">
        {
          SURFACES.map((surface) => (
            <li class="doc__panel" style={`--shot: url('${surface.shot}'); --bloom: ${surface.bloom}`}>
              <h3 class="doc__panelHead">{surface.head}</h3>
              <p class="doc__panelBody">{surface.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* The proof. Marks, then the three desks running it, each linking to the
      story rather than repeating it. The wash ground is what sets this band
      apart from the argument above it. */}
  <section class="pband pband--refs guides" aria-labelledby="desks-running-it">
    <div class="doc__inner doc__body pband__inner">
      <h2 id="desks-running-it">Desks running it today</h2>
      <p>
        Three of them, at three very different volumes, writing into three
        different systems. Each one arrived as mail first.
      </p>
      <LogoBelt />
      <CaseRefs stories={stories} />
    </div>
  </section>

  {/* Framer's version of this page ends on an "Explore next" grid of related
      skills. The idea is right — a product page should hand a reader the next
      one — but the pages it links to (email triage, the skill library,
      continuous learning) do not exist in this build, and linking to them
      would be three 404s. These are the real destinations a reader wants from
      here, so the band keeps the shape and drops the fiction. */}
  <section class="pband guides" aria-labelledby="explore-next">
    <div class="doc__inner doc__body pband__inner">
      <h2 id="explore-next">Explore next</h2>
      <ul class="refs">
        {
          NEXT.map((item) => (
            <li class="ref">
              <a class="ref__card" href={item.href}>
                <span class="ref__co">{item.title}</span>
                <span class="ref__line">{item.blurb}</span>
                <span class="ref__foot">
                  <span class="ref__erp">{item.label}</span>
                  <span class="ref__go" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pband pband--faq guides" aria-label="Common questions">
    <div class="doc__inner doc__body pband__inner">
      <FaqGroups groups={groups} />
    </div>
  </section>

  <section class="pband pband--end guides" aria-label="Book a demo">
    <div class="doc__inner doc__body pband__inner">
      <aside class="docend">
        <Pattern />
        <p class="docend__head">
          Bring your most complex order. We will show you what happens to it,
          live, in 30 minutes.
        </p>
        <a class="btn-os btn-os--fill btn-os--lg" href="/demo/">
          Book a demo
          <Arrow />
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
