---
/**
 * The pricing page.
 *
 * There is no price figure anywhere on it, deliberately: the number is quoted
 * per workspace on the call. What the page can give a reader before that call
 * is the shape — which of the three plans their desk is, and what the step to
 * the next one buys — so it names the plans and prints no amounts. That is also
 * why the Offer in the structured data carries a `priceSpecification` with a
 * description and no `price`: inventing a figure to earn a rich result would
 * contradict the page.
 *
 * Its own banded layout rather than the document shape: this is a landing
 * page, and each band is a separate argument.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DocMasthead from '~/components/DocMasthead.astro';
import Pattern from '~/components/Pattern.astro';
import FaqGroups from '~/components/FaqGroups.astro';
import TeamGrid from '~/components/TeamGrid.astro';
import LogoBelt from '~/components/LogoBelt.astro';
import CaseRefs from '~/components/CaseRefs.astro';
import Arrow from '~/components/Arrow.astro';
import { GTM_TEAM } from '~/data/team';
import {
  organization,
  website,
  softwareApplication,
  faqPage,
  type QA,
} from '~/lib/schema';

const groups = (await getCollection('faqs', ({ data }) => data.page === 'pricing')).sort(
  (a, b) => a.data.order - b.data.order
);

const pairs: QA[] = groups.flatMap((group) =>
  group.data.items.map((item) => ({
    question: item.question,
    answer: item.answer.join(' '),
  }))
);

const stories = (await getCollection('customers', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

/* The three plans, without the figures.
 *
 * The page still carries no price: the number is settled on the call, and a
 * list price would be a number for a desk we have not seen. What a reader can
 * have before that call is the shape -- which plan their desk is, and what the
 * step to the next one buys.
 *
 * Two lists per card, and deliberately not a comparison matrix. `included` is
 * what the plan counts -- inboxes, allowance, seats -- and `features` is what
 * the desk can do with it. From Team upward the features open with the plan
 * below rather than repeating it, so three cards stay three short lists instead
 * of one long list printed three times.
 *
 * Four rows in each list on every card, which is not tidiness: the fourth
 * `included` row is the same fact in all three -- whether Hoshii writes back
 * into your systems -- so the two crosses and the tick that answers them land
 * on one line across the row. A plan reads as a choice only when what it gives
 * up is on the card.
 *
 * Nothing here restates the slab under the cards: that carries what every plan
 * has, and a card only carries what tells it apart from the one before. */
type Plan = {
  name: string;
  /** Only the plan most desks land on carries one. */
  tag?: string;
  pitch: string;
  /** `no` marks the one thing the plan does not do. */
  included: { text: string; no?: boolean }[];
  /** The plan below, which this one opens its feature list with. */
  from?: string;
  features: string[];
};

const PLANS: Plan[] = [
  {
    name: 'Launch',
    pitch: 'For smaller teams with one shared inbox.',
    included: [
      { text: 'Connect one shared inbox and up to 2 personal inboxes' },
      { text: 'A monthly credit allowance for basic agent work' },
      { text: 'Unlimited read\u2011only users' },
      { text: 'No writing back into your systems', no: true },
    ],
    features: [
      'Drafts and confirmations',
      'Context search across your own material',
      'Knowledge base and self-learning',
      'Inbox analytics',
    ],
  },
  {
    name: 'Team',
    tag: 'Most desks',
    pitch: 'For mid\u2011 to larger teams with advanced inbox operations.',
    included: [
      { text: 'Connect two shared inboxes and up to 5 personal inboxes' },
      {
        text: 'A larger monthly credit allowance to delegate first individual workstreams',
      },
      { text: 'Unlimited read\u2011only users' },
      { text: 'No writing back into your systems', no: true },
    ],
    from: 'Launch',
    features: ['Single sign\u2011on', 'Team analytics', 'Priority support'],
  },
  {
    name: 'Automate',
    pitch: 'For a desk that wants the entry posted, not only prepared.',
    included: [
      { text: 'Connect two shared inboxes and up to 5 personal inboxes' },
      {
        text: 'The largest monthly credit allowance for enabling teams to do advanced work',
      },
      { text: 'Unlimited read\u2011only users' },
      { text: 'Writes back into your systems' },
    ],
    from: 'Team',
    features: [
      'Order processing',
      'Your own security review and paperwork',
      'Named support',
    ],
  },
];

const CREDITS = [
  {
    head: 'An allowance every month',
    body: 'Every plan carries one, sized with you against an average month rather than a peak.',
  },
  {
    head: 'It rolls over',
    body: 'Unused credits never expire, so a quiet month builds the balance a busy one draws on.',
  },
  {
    head: 'It moves with the desk',
    body: 'Add to the allowance in any month, and take it off again in the next.',
  },
];

const INCLUDED = [
  'Read access to your ERP',
  'Every shipped Skill',
  'The Outlook and Gmail add‑in',
  'EU hosting and email encryption',
  'Inbox analytics',
  '25+ languages, typed, scanned or spoken',
];

---

<BaseLayout
  title="Pricing"
  description="Three Hoshii plans — Launch, Team and Automate — and what the step from one to the next buys. The number itself is quoted per desk on a thirty-minute call."
  path="/pricing/"
  mainClass="doc page--pricing doc--wide"
  schema={[
    organization(),
    website(),
    softwareApplication(),
    faqPage(pairs),
  ]}
>
  <DocMasthead
    title="Pricing"
    sub="Smooth operations, "
    accent="starting from two coffees a day."
    variant="dark"
  >
    <p class="pricehead__acts">
      <a class="btn-os btn-os--accent btn-os--fill btn-os--lg" href="/demo/">
        Talk to sales
        <Arrow />
      </a>
    </p>
  </DocMasthead>

  <section class="pband pband--plans guides" aria-label="The three plans">
    <div class="doc__inner doc__body pband__inner">
      <ul class="plans">
        {
          PLANS.map((plan) => (
            <li class={`plan${plan.tag ? ' plan--rec' : ''}`}>
              {plan.tag && <p class="plan__tag">{plan.tag}</p>}
              <h2 class="plan__name">{plan.name}</h2>
              <p class="plan__pitch">{plan.pitch}</p>

              {/* One coloured button on the row, on the plan most desks land
                  on. Three identical accent buttons is three cards shouting the
                  same thing and a reader picking on price they cannot see. */}
              <p class="plan__cta">
                <a
                  class={`btn-os ${plan.tag ? 'btn-os--fill' : 'btn-os--accent'}`}
                  href="/demo/"
                >
                  Talk to sales
                  <Arrow />
                </a>
              </p>

              <p class="plan__groupHead">Included</p>
              <ul class="plan__list">
                {plan.included.map((item) => (
                  <li class={item.no ? 'plan__without' : undefined}>{item.text}</li>
                ))}
              </ul>

              <p class="plan__groupHead">Features</p>
              <ul class="plan__list">
                {plan.from && (
                  <li class="plan__from">
                    Everything in <span class="plan__ref">{plan.from}</span>
                  </li>
                )}
                {plan.features.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <div class="creds">
        <h2 class="creds__head">How the work on top is metered</h2>
        <ul class="creds__list">
          {
            CREDITS.map((credit) => (
              <li>
                <strong>{credit.head}.</strong> {credit.body}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="kit">
        <h3 class="kit__head">On every plan, at no extra charge</h3>
        <ul class="kit__list">
          {INCLUDED.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="pband pband--talk guides" aria-labelledby="who-you-will-be-talking-to">
    <div class="doc__inner doc__body pband__inner">
      <h2 id="who-you-will-be-talking-to">Who you will be talking to</h2>
      <TeamGrid members={GTM_TEAM} quotes={false} sizes="52px" />
      {/* A button, not a mail address. The three faces above are the answer to
          "who will I be dealing with"; the next step after reading that is to
          book time with them, which is the same step every other page ends on. */}
      <p class="pband__act">
        <a class="btn-os btn-os--accent" href="/demo/">
          Talk to sales
          <Arrow />
        </a>
      </p>
    </div>
  </section>

  <section class="pband pband--refs guides" aria-labelledby="desks-already-priced-this-way">
    <div class="doc__inner doc__body pband__inner">
      <p class="doc__proofLabel">Quoted this way for 500+ B2B operations teams</p>
      <LogoBelt />

      <h2 id="desks-already-priced-this-way">Desks already priced this way</h2>
      <p>
        Three of them, at three very different volumes, writing into three
        different systems. Each one was quoted on its own volume and the systems
        it writes into.
      </p>
      <CaseRefs stories={stories} />
    </div>
  </section>

  <section class="pband pband--faq guides" aria-label="Common questions about pricing">
    <div class="doc__inner doc__body pband__inner">
      <FaqGroups groups={groups} />
    </div>
  </section>

  <section class="pband pband--end guides" aria-label="Talk to sales">
    <div class="doc__inner doc__body pband__inner">
      <aside class="docend">
    <Pattern />
        <p class="docend__head">Nobody leaves this call without a price.</p>
        <a class="btn-os btn-os--fill btn-os--lg" href="/demo/">
          Talk to sales
          <Arrow />
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
